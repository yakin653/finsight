# Copier ce fichier : copy .env.example .env
# Ne jamais y mettre une vraie clé, et ne pas commiter .env.

# Mot de passe local. Le volume Docker existant a été créé avec cette valeur.
POSTGRES_PASSWORD=monmdp
POSTGRES_DB=finsight

# Uvicorn lancé sur la machine (hôte = localhost).
# Le conteneur n'utilise pas cette ligne : docker-compose.yml pointe vers le service « db ».
DATABASE_URL=postgresql+psycopg://postgres:monmdp@localhost:5432/finsight

# Neon (déploiement uniquement). Noms distincts de DATABASE_URL : rien ne les lit en local,
# ni le code, ni docker-compose.yml. La validation locale utilise donc toujours la base locale.
# Au déploiement, la valeur de NEON_DATABASE_URL se colle dans la variable DATABASE_URL de Render
# (voir docs/DEPLOY-API-RENDER.md). Valeurs factices ci-dessous, à laisser commentées ici.
# NEON_DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@ep-exemple-pooler.region.aws.neon.tech/neondb?sslmode=require
# NEON_DATABASE_URL_UNPOOLED=postgresql+psycopg://utilisateur:motdepasse@ep-exemple.region.aws.neon.tech/neondb?sslmode=require

# Ollama reste sur la machine. Depuis Docker, host.docker.internal joint l'hôte.
OLLAMA_URL=http://host.docker.internal:11434
# llama3.2:3b est le repli. Un modèle plus grand (llama3.1:8b) améliore la reformulation si la RAM le permet.
OLLAMA_MODEL=llama3.2:3b
# Dossier des fiches. Vide = /knowledge dans Docker, sinon finsight/knowledge.
KNOWLEDGE_DIR=

# 1 = mettre à jour Yahoo au démarrage si la série n'est pas déjà marquée yahoo.
# 0 = ne pas appeler le réseau (utile pour les tests).
MARKET_REFRESH_ON_START=1

# Jeton de session. Change cette valeur avant une vraie mise en ligne.
JWT_SECRET=change-me-marketpulse-dev-secret-32b

# Origines autorisées à envoyer le cookie de session.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Push. Générer avec : python scripts/gen_vapid.py
# Sans ces clés, les notifications dans l'application fonctionnent quand même.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:marketpulse@localhost

# Adresse publique du site. Le lien de réinitialisation est toujours construit avec elle,
# jamais avec l'en-tête Host de la requête.
APP_PUBLIC_URL=http://localhost:3000
APP_ENV=development

# development : le lien est écrit dans les logs si SMTP_HOST est vide.
# production : le lien n'est pas écrit, sauf si DEV_LOG_RESET_LINKS=true.
DEV_LOG_RESET_LINKS=

# Cookie de session. En production : COOKIE_SECURE=true (HTTPS).
# SameSite=Lax, HttpOnly et Path=/ sont toujours posés.
# « Se souvenir de moi » décoché : pas de Max-Age, le cookie meurt avec le navigateur.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Mot de passe oublié : un code à 6 chiffres (10 minutes, usage unique, 5 essais) part par e-mail.
# Trois cas, annoncés au démarrage de l'API (ligne « E-mails : … ») :
#  - SMTP_HOST vide : aucun e-mail. En développement, le code est écrit dans les logs de l'API.
#  - Mailpit (docker compose --profile mail up -d) : SMTP_HOST=mailpit et SMTP_PORT=1025.
#    Boîte de TEST sur http://localhost:8025 : rien n'arrive dans une vraie boîte mail.
#  - Vraie boîte mail : un compte d'envoi. Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#    SMTP_USER=ton.adresse@gmail.com, SMTP_PASSWORD=un « mot de passe d'application » Google
#    (https://myaccount.google.com/apppasswords, validation en 2 étapes requise), SMTP_FROM=la même adresse.
#    Port 587 = STARTTLS, port 465 = SSL. Le mot de passe ne va que dans .env, jamais ici.
# Vérifier l'envoi : docker exec finsight-backend python -m app.mailcheck destinataire@exemple.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=marketpulse@localhost

# Optionnel, désactivé par défaut. Le flux réel n'a pas été exécuté contre Google (non testé).
# Les règles (state signé, e-mail vérifié, pas de fusion automatique) sont couvertes par pytest.
# Sans ces deux valeurs, « Continuer avec Google » n'est pas affiché.
# Console Google : client OAuth « Application Web », URI de redirection
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel. Pipeline de news historique. Laisser vide si inutilisé.
FINNHUB_API_KEY=
